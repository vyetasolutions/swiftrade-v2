  color:#5a2ca0;
  font-size:16px;
  cursor:pointer;
  white-space:normal;
  line-height:1.4;
  transition:.25s;
}

.optionBtn:hover{
  background:#5a2ca0;
  color:#fff;
}

.primary{
  animation:pulse 1.4s infinite;
}

