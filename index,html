.inputField{
  width:92%;
  padding:14px;
  font-size:16px;
  border-radius:14px;
  border:2px solid #5a2ca0;
  margin:10px 0;
}

/* Summary */
#summaryContainer{
  text-align:left;
  background:#faf8ff;
  border-radius:14px;
  padding:18px;
  margin:18px 0;
}
#summaryContainer p{
  margin:6px 0;
  font-size:15px;
}

/* Footer actions */
.actionRow{
  display:flex;
  gap:12px;
  margin-top:18px;
}
.actionRow button{
  flex:1;
}

/* Pulse */
@keyframes pulse{
  0%{box-shadow:0 0 0 0 rgba(90,44,160,.4);}
  70%{box-shadow:0 0 0 14px rgba(90,44,160,0);}
  100%{box-shadow:0 0 0 0 rgba(90,44,160,0);}
}

/* === SwifTrade Orb === */
.orb-wrap {
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:18px;
  margin-bottom:12px;
  position:relative;
}

.orb {
  width:88px;
  height:88px;
  border-radius:50%;
  background:
    radial-gradient(circle at 30% 30%,
      #9f7aea,
      #5a2ca0 55%,
