}

/* Card */
.card{
  padding:36px 32px;
  text-align:center;
  position:relative;
}

/* Headings */
h2,h3{
  color:#3a1f6f;
  margin-bottom:8px;
}
.step{
  font-size:13px;
  color:#777;
  margin-bottom:16px;
}

/* Buttons */
.optionBtn{
  width:100%;
