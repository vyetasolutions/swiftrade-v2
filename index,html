<body>
<div id="chatContainer">

  <div id="progressBar"><div id="progress"></div></div>

  <div class="card active" id="introCard">
    <div class="orb-wrap">
      <div class="orb-halo"></div>
      <div class="orb"></div>
    </div>

    <h2 class="intro-title">Hi, I’m SwifTrade</h2>
    <p class="intro-sub">
      Press <strong>Get Started</strong> To Find What You’re Looking For.
    </p>

    <button class="optionBtn primary" id="startBtn">Get Started</button>
  </div>

  <div class="card" id="questionCard" style="display:none;"></div>
</div>

<script>
const introCard = document.getElementById("introCard");
const questionCard = document.getElementById("questionCard");
const progress = document.getElementById("progress");

let responses = {};
let stepStack = [];

/* Categories */
const categories = [
 { name:'Automotive', sub:[
  {name:'Vehicles', fields:['Make','Model','Year','Condition','Color','Budget','Quantity','Notes']},
  {name:'Car Parts & Accessories', fields:['Part Type','Vehicle Make','Vehicle Model','Budget','Quantity','Notes']},
  {name:'Insurance', fields:['Vehicle Type','Insurance Type','Urgency','Notes']},
  {name:'Roadside Assistance', fields:['Vehicle Type','Urgency','Location','Notes']},
  {name:'Other', fields:['Describe your requirement']}
 ]},
 { name:'Electronics', sub:[
  {name:'Mobile Phones', fields:['Brand','Model','Storage','Condition','Budget','Quantity','Notes']},
  {name:'Tablets', fields:['Brand','Model','Storage','Condition','Budget','Quantity','Notes']},
  {name:'Other', fields:['Describe your requirement']}
 ]},
 { name:'Building Materials', sub:[
  {name:'Materials', fields:['Material Type','Quantity','Unit','Delivery Location','Budget','Notes']}
 ]},
 { name:'Professional Services', sub:[
  {name:'Service', fields:['Service Type','Scope','Urgency','Budget','Notes']}
 ]},
 { name:'Microfinance', sub:[
  {name:'Loan', fields:['Loan Type','Amount Needed','Repayment Period','Business Sector','Notes']}
 ]},
 { name:'Lodging', sub:[
  {name:'Accommodation', fields:['Type','Rooms','Duration','Location','Budget','Notes']}
 ]},
 { name:'Other', sub:[{name:'Other', fields:['Describe your requirement']}]}
];

document.getElementById("startBtn").onclick=()=>{
  introCard.style.display="none";
  questionCard.style.display="block";
  showCategories();
};

/* Navigation helpers */
function setStep(html, pct){
  questionCard.innerHTML = html;
  progress.style.width = pct+"%";
}

/* Step 1 */
function showCategories(){
  stepStack.push(showCategories);
  setStep(`<div class="step">Step 1 of 4</div><h3>Select Category</h3>`,25);
  categories.forEach(c=>{
    const b=document.createElement("button");
    b.className="optionBtn";
    b.textContent=c.name;
    b.onclick=()=>{responses.category=c.name; showSub(c.sub);}
    questionCard.appendChild(b);
  });
}

/* Step 2 */
function showSub(sub){
  stepStack.push(()=>showSub(sub));
  setStep(`<div class="step">Step 2 of 4</div><h3>Select Subcategory</h3>`,50);
  sub.forEach(s=>{
    const b=document.createElement("button");
    b.className="optionBtn";
    b.textContent=s.name;
    b.onclick=()=>{responses.subcategory=s.name; showFields(s.fields);}
    questionCard.appendChild(b);
  });
}

/* Step 3 */
function showFields(fields){
  stepStack.push(()=>showFields(fields));
  setStep(`<div class="step">Step 3 of 4</div><h3>Provide Details</h3>`,75);

  fields.forEach(f=>{
    const i=document.createElement("input");
    i.className="inputField";
    i.placeholder=f;
    questionCard.appendChild(i);
  });

  const phone=document.createElement("input");
  phone.className="inputField";
  phone.placeholder="Phone Number";
  questionCard.appendChild(phone);

  const next=document.createElement("button");
  next.className="optionBtn primary";
  next.textContent="Review Request";
  next.onclick=buildSummary;
  questionCard.appendChild(next);

  addBack();
}

/* Step 4 – Summary */
function buildSummary(){
  document.querySelectorAll(".inputField").forEach(i=>{
    responses[i.placeholder]=i.value;
  });

  responses.transaction_code="TRX"+Math.floor(100000+Math.random()*900000);

  setStep(`<div class="step">Step 4 of 4</div><h3>Review & Confirm</h3>`,100);

  const box=document.createElement("div");
  box.id="summaryContainer";

  Object.entries(responses).forEach(([k,v])=>{
    const p=document.createElement("p");
    p.innerHTML=`<strong>${k}:</strong> ${v}`;
    box.appendChild(p);
  });

  questionCard.appendChild(box);

  const actions=document.createElement("div");
  actions.className="actionRow";

  const edit=document.createElement("button");
  edit.className="optionBtn";
  edit.textContent="Edit";
  edit.onclick=()=>stepStack[stepStack.length-1]();

  const submit=document.createElement("button");
  submit.className="optionBtn primary";
  submit.textContent="Submit Request";
  submit.onclick=submitRequest;

  actions.appendChild(edit);
  actions.appendChild(submit);
  questionCard.appendChild(actions);
}

/* Submit */
function submitRequest(){
  responses.timestamp=new Date().toISOString();

  fetch("https://script.google.com/macros/s/AKfycbzHPRlehTxGRO_Ed9SKHKCbE07pSSjoZqtZdg-xaxhi7STfptq7TeLXRLHPIPzfQgRG/exec",{
    method:"POST",
    mode:"no-cors",
    body:JSON.stringify(responses),
    headers:{"Content-Type":"application/json"}
  });

  questionCard.innerHTML=`
    <h3>✅ Request Submitted</h3>
    <p><strong>Transaction Code:</strong> ${responses.transaction_code}</p>
    <button class="optionBtn primary" onclick="location.reload()">Submit Another Request</button>
  `;
}

/* Back button */
function addBack(){
  const back=document.createElement("button");
  back.className="optionBtn";
  back.textContent="Back";
  back.onclick=()=>{
    stepStack.pop();
    stepStack.pop();
    stepStack[stepStack.length-1]();
  };
  questionCard.appendChild(back);
}
</script>
</body>
</html>


